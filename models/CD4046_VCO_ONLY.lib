.subckt CD4046_VCO_ONLY p1 p2 p3 p4 p5 p6 p7 p8
+ p9 p10 p11 p12 p13 p14 p15 p16
+ params: K=0.70574 ROUT=1000

* Timing-resistor current follows control voltage.
B_RBIAS rb p8 V={max(0,min(V(p9,p8),V(p16,p8)))}
V_RSENSE rb p11 0
R_RLEAK p11 p8 1T
R_INPUT p9 p8 1G
R_INHIBIT p5 p8 1G

* External timing capacitor connects between p6 and p7.
V_CREF p7 p8 0
R_CLEAK p6 p7 1T

* Hysteretic oscillator: thresholds at 25% and 75% of VDD.
B_THRESH th p8 V={
+ (V(p6,p7)-0.5*V(p16,p8))
+ /max(0.25*V(p16,p8),0.01)}

R_STATE p16 state 1k
S_STATE state p8 th p8 SCHMITT
.model SCHMITT SW(RON=1 ROFF=1T VT=0 VH=1)

* Alternate capacitor charging and discharging.
B_CHARGE p7 p6 I={
+ (V(p5,p8)>0.5*V(p16,p8)) ? 0 :
+ K*max(I(V_RSENSE),0)*
+ ((V(state,p8)>0.5*V(p16,p8)) ? 1 : -1)}

* VCO output; inhibit high forces output low.
B_OUTPUT out p8 V={
+ (V(p5,p8)>0.5*V(p16,p8)) ? 0 :
+ ((V(state,p8)>0.5*V(p16,p8)) ? V(p16,p8) : 0)}

R_OUTPUT out p4 {ROUT}

.ends CD4046_VCO_ONLY
